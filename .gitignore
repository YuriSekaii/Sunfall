*.blend1
*.blend2

# OS generated files
.DS_Store
Thumbs.db

# Extracted prototype reference assets (copyrighted)
assets_ref/

# Rust Cargo build artifacts (keep addons/sunfall_rust/bin/*.dll for zero-setup launch)
rust/target/
